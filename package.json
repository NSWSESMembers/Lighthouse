    "typescript-eslint": "^8.71.2",
    "underscore": "^1.13.8",
    "vitest": "^5.0.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^4.9.1",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-merge": "^5.8.0",
    "zip-webpack-plugin": "^4.0.3"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "uuid": "^11.1.1",
    "dc": {
      "d3": "$d3"
    }
  }
}
