{
  "name": "lighthouse",
  "version": "1.0.0",
  "description": "(Formerly \"*Beacon Enhancement Suite*\", \"*BES*\".)",
  "homepage": "https://github.com/OSPFNeighbour/Lighthouse#readme",
  "bugs": {
    "url": "https://github.com/OSPFNeighbour/Lighthouse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSPFNeighbour/Lighthouse.git"
  },
  "license": "MIT",
  "author": "Tim Dykes",
  "main": "background.js",
  "scripts": {
    "prod": "webpack --config webpack.prod.js",
    "dev": "webpack --config webpack.dev.js",
    "lint": "eslint --max-warnings=0 ./src",
    "prettier": "prettier --write",
    "start": "webpack --watch --config webpack.watch.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lad:demo": "node scripts/lad-docs/demo.mjs",
    "lad:shots": "node scripts/lad-docs/capture.mjs",
    "lad:samples": "node scripts/lad-docs/fetch-samples.mjs",
    "lad:bench": "node scripts/lad-docs/bench.mjs",
    "stats:demo": "node scripts/stats-docs/demo.mjs",
    "stats:shots": "node scripts/stats-docs/capture.mjs",
    "stats:check": "node scripts/stats-docs/check.mjs",
    "summary:demo": "node scripts/summary-docs/demo.mjs",
    "summary:shots": "node scripts/summary-docs/capture.mjs",
    "summary:check": "node scripts/summary-docs/check.mjs",
    "advexport:demo": "node scripts/advexport-docs/demo.mjs",
    "advexport:shots": "node scripts/advexport-docs/capture.mjs",
    "advexport:check": "node scripts/advexport-docs/check.mjs",
    "nitcexport:demo": "node scripts/nitcexport-docs/demo.mjs",
    "nitcexport:shots": "node scripts/nitcexport-docs/capture.mjs",
    "nitcexport:check": "node scripts/nitcexport-docs/check.mjs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "npm run prettier",
      "npm run lint"
    ]
  },
  "browserslist": "> 0.25%, not dead",
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@microsoft/signalr": "^10.0.11",
    "@tmcw/togeojson": "^5.7.0",
    "@xmldom/xmldom": "^0.9.12",
    "bootstrap": "^4.6.2",
    "bootstrap5": "npm:bootstrap@^5.3.8",
    "chroma-js": "^2.4.2",
    "crossfilter2": "^1.5.4",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.9",
    "dc": "^4.2.7",
    "esri-leaflet": "^3.0.19",
    "esri-leaflet-vector": "^4.3.2",
    "exceljs": "^4.4.0",
    "fontawesome7": "npm:@fortawesome/fontawesome-free@^7.3.1",
    "gridstack": "^14.0.0",
    "humanize-duration": "^3.35.0",
    "jquery": "^3.6.0",
    "jsx-dom-factory": "^1.2.0",
    "knockout": "^3.5.3",
    "knockout-secure-binding": "^0.5.5",
    "leaflet": "^1.9.4",
    "leaflet-easybutton": "^2.4.0",
    "leaflet-fullscreen": "git+https://github.com/Leaflet/Leaflet.fullscreen.git",
    "leaflet-geosearch": "^4.4.0",
    "leaflet-minimap": "^3.6.1",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet-svg-shape-markers": "^1.3.0",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.measure": "^1.0.0",
    "leaflet.polylinemeasure": "^3.0.0",
    "leaflet.vectorgrid": "^1.3.0",
    "moment": "^2.31.0",
    "nunjucks": "^3.2.4",
    "remove": "^0.1.5",
    "stopwords": "0.0.9"
